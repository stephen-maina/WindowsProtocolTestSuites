<?xml version="1.0" encoding="utf-8"?>
<TestSite xmlns="http://schemas.microsoft.com/windows/ProtocolsTest/2007/07/TestConfig"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.microsoft.com/windows/ProtocolsTest/2007/07/TestConfig http://schemas.microsoft.com/windows/ProtocolsTest/2007/07/TestConfig.xsd">
  <Properties>
    <Property name="TestName" value="SMBD" />
    <Property name="FeatureName" value="MS-SMBD" />

    <!--Security package for SMB2 authentication. Supported value is one of "Negotiate", "Kerberos" and "Ntlm".-->
    <Property name="SecurityPackageForSmb2UserAuthentication" value="Negotiate"/>
    <!-- Set value for Smb2ConnectionTimeoutInSeconds greater than KeepAliveInterval -->
    <Property name="Smb2ConnectionTimeoutInSeconds" value="125" />
    <Property name="DisconnectionTimeoutInSeconds" value="15" />

    <!-- The TCP port value for SMBD transport -->
    <Property name="SmbdTcpPort" value="445" />
    <!--
      SMBD parameters that initialized on connection.
      Observed against the Linux SUT: a MaxFragmentedSize of 131072 (128 KiB) makes the server drop the
      connection during SMBD negotiate (client sees STATUS_CANCELLED); 262144 negotiates successfully.
      Tests read these values from this file; they are not hardcoded in the test cases.

      Specification notes for the values below:
      - MaxReceiveSize must be at least 128 bytes and MaxFragmentedSize at least 131,072 bytes
        ([MS-SMBD] Section 3.1.5.6 / 3.1.5.7). There is no specified upper bound.
      - ReceiveCreditMax=255, SendCreditTarget=255, MaxSendSize=1364 are the Windows default values from
        [MS-SMBD] Appendix A (Windows product behavior). The protocol only requires them to be greater than 0
        (credits) and at least 128 bytes (sizes), so tune them to match the SUT.
      - CreditsRequested in SMBD Data Transfer messages uses SendCreditTarget ([MS-SMBD] Section 3.1.5.1).
    -->
    <Property name="ReceiveCreditMax" value="255" />
    <Property name="SendCreditTarget" value="255" />
    <Property name="MaxSendSize" value="1364" />
    <Property name="MaxFragmentedSize" value="262144" />
    <Property name="MaxReceiveSize" value="8192" />
    <Property name="KeepAliveInterval" value="120" />

    <!--
      WINDOWS-SPECIFIC (product behavior) values. These are applied by the test cases only when the "Platform"
      property identifies a Windows SUT; a NonWindows SUT never uses them.

      WindowsMaxPreferredSendSize: [MS-SMBD] Appendix A <6> (Section 3.1.5.6) - Windows Server 2012 R2 and later fail the
      SMBD Negotiate Request with STATUS_INSUFFICIENT_RESOURCES if PreferredSendSize is greater than this value (8136).
      WindowsMinMaxReadWriteSize: [MS-SMBD] Appendix A <7> (Section 3.1.5.7) - Windows limits MaxReadWriteSize to 1048576
      (Windows Server 2012 without [MSKB-2934016]) or 8388608 (otherwise), so a Windows SUT returns at least this value.
      The protocol itself defines no minimum MaxReadWriteSize.
    -->
    <Property name="WindowsMaxPreferredSendSize" value="8136" />
    <Property name="WindowsMinMaxReadWriteSize" value="1048576" />

    <!--
      IMPLEMENTATION-SPECIFIC values (not defined by the specifications).

      ClientMaxReadWriteSize: [MS-SMBD] Section 3.1.5.7 - the client sets Connection.MaxReadWriteSize to the smaller of
      "an implementation-specific value" and the MaxReadWriteSize received from the server. This is that value.
      QueryNetworkInterfaceMaxOutputResponse: MaxOutputResponse of FSCTL_QUERY_NETWORK_INTERFACE_INFO; it must be large
      enough to hold the SUT's network interface list ([MS-SMB2] Section 2.2.31). The nonzero requested size is
      capped at negotiated SMB2 MaxTransactSize, with the corresponding SMB2 credit charge.
      RdmaChannelDataSizeInByte: nonzero requested payload in ReadWriteMultipleBufferDescriptorList, capped at
      the negotiated SMB2 MaxReadSize/MaxWriteSize and SMBD MaxReadWriteSize. Other size-boundary cases retain
      their scenario-specific sizes.
      ExpectDisconnectOnReceiveOverflow: optional opt-in for the provider-specific MaxReceiveSize overflow test.
      Set true only for an independently verified SUT/provider overflow-disconnection contract. Section 3.1.5.8
      does not mandate that an oversized RDMA receive disconnects. False (also the absent-property default) skips
      this scenario before connecting, regardless of Platform.
    -->
    <Property name="ClientMaxReadWriteSize" value="1048576" />
    <Property name="QueryNetworkInterfaceMaxOutputResponse" value="65536" />
    <Property name="RdmaChannelDataSizeInByte" value="1048576" />
    <Property name="ExpectDisconnectOnReceiveOverflow" value="false" />

    <!--maximum number of outstanding Receive requests for RDMA driver-->
    <Property name="InboundEntries" value="63" />
    <!--maximum number of outstanding Send, SendAndInvalidate, Bind, Invalidate, Read, and Write requests for RDMA driver.-->
    <Property name="OutboundEntries" value="63" />
    <!--maximum inbound read limit for the local Network Direct adapter. This value can be zero if you do not support-->
    <Property name="InboundReadLimit" value="10" />
    <!-- 
      Endianness of BufferDescriptor returned from RDMA-NIC Driver. In MS-SMBD, 
      all the messages MUST be transported as little-endian. If the buffer descriptor returned from RDMA-NIC Driver is big-endian,
      the buffer descriptor MUST be reversed to little-endian.
      Supported value are "BigEndian" & "LittleEndian"
    -->
    <Property name="EndianOfBufferDescriptor" value="BigEndian" />

    <!--Active TDIs that would impact test, multiple values should be separated by semicolons-->
    <Property name ="ActiveTDI" value="" />
    <!--Set to true, if need RDMA layer verbose logging, otherwise set to false-->
    <Property name ="RdmaLayerLoggingEnabled" value ="false" />

    <!--
      Per-test diagnostics policy. Diagnostics remain disabled unless explicitly enabled.
      Durations use the invariant TimeSpan "c" format. Capture targets are separated by semicolons;
      an empty target list derives only the configured ClientRNicIp.
    -->
    <Property name="Diagnostics.Enabled" value="true" />
    <Property name="Diagnostics.ArtifactRoot" value="C:\WPTS-Diagnostics" />
    <Property name="Diagnostics.Capture.Provider" value="Automatic" />
    <Property name="Diagnostics.Capture.ToolPath" value="" />
    <Property name="Diagnostics.Capture.Targets" value="" />
    <Property name="Diagnostics.Capture.TrafficScope" value="RdmaFocused" />
    <Property name="Diagnostics.Capture.StartTimeout" value="00:00:30" />
    <Property name="Diagnostics.Capture.StopTimeout" value="00:01:00" />
    <Property name="Diagnostics.Capture.MaxDuration" value="00:05:00" />
    <Property name="Diagnostics.Capture.MaxBytes" value="536870912" />
    <Property name="Diagnostics.Capture.Format" value="Native" />
    <Property name="Diagnostics.Logs.NativeEnabled" value="false" />
    <Property name="Diagnostics.Retention" value="KeepAll" />
    <!--
      Session grouping: every run writes to <ArtifactRoot>\<SessionName>\tests\<test>__<id>\ so each test
      case has its own folder holding capture.etl, manifest.json and ptf-log.ndjson together.
        SessionName: empty = new "session-<yyyyMMdd-HHmmss>" per run (runs never overwrite each other).
                     A fixed name (e.g. "baseline") is reused by later runs; "{timestamp}" is replaced by
                     the run start time, e.g. "nightly-{timestamp}".
        MaxSessions: 0 = keep every session; N > 0 = after a run starts, delete the oldest session folders
                     (only folders containing a .wpts-session marker) so at most N remain.
    -->
    <Property name="Diagnostics.SessionName" value="" />
    <Property name="Diagnostics.Retention.MaxSessions" value="0" />
    <!--
      RDMA traffic bypasses the Windows network stack, so capture.etl (netsh) cannot see it.
      When enabled, the Mellanox/NVIDIA NIC sniffer (Mlx5Cmd -Sniffer) also writes rdma.pcap
      next to capture.etl for each test. Best effort: if the tool or adapter is not found, the test
      still runs with the netsh capture only. ToolPath empty uses the WinOF-2 default location.
    -->
    <Property name="Diagnostics.Capture.RdmaSniffer.Enabled" value="true" />
    <Property name="Diagnostics.Capture.RdmaSniffer.ToolPath" value="" />
  </Properties>
  <Adapters>
    <Adapter xsi:type="powershell" name="ISutProtocolControlAdapter" scriptdir=".\SutProtocolControlAdapter" />
  </Adapters>

  <TestLog defaultprofile="Verbose">
    <Sinks>
      <File id="Debug" directory=".\" file="MS-SMBD_Log.txt" format="text" />
      <File id="XMLLog" directory=".\" file="MS-SMBD_Log.xml" format="xml" />
      <Sink id="PipeSink" type="Microsoft.Protocols.TestTools.Logging.PipeSink"/>
    </Sinks>
    <Profiles>
      <Profile name="Verbose" extends="Error">

        <!-- Show for CommandlineConsole -->
        <Rule kind="TestStep" sink="CommandLineConsole" delete="false"/>
        <Rule kind="CheckFailed" sink="CommandLineConsole" delete="false"/>
        <Rule kind="CheckInconclusive" sink="CommandLineConsole" delete="false"/>
        <Rule kind="Comment" sink="CommandLineConsole" delete="false"/>
        <Rule kind="Warning" sink="CommandLineConsole" delete="false"/>
        <Rule kind="Debug" sink="CommandLineConsole" delete="false"/>
        <Rule kind="TestFailed" sink="CommandLineConsole" delete="false"/>
        <Rule kind="TestInconclusive" sink="CommandLineConsole" delete="false"/>
        <Rule kind="TestPassed" sink="CommandLineConsole" delete="false"/>

        <!-- Show for Console -->
        <Rule kind="TestStep" sink="Console" delete="false"/>
        <Rule kind="Checkpoint" sink="Console" delete="false"/>
        <Rule kind="Debug" sink="Console" delete="false"/>
        <Rule kind="BeginGroup" sink="Console" delete="false"/>
        <Rule kind="EndGroup" sink="Console" delete="false"/>

        <!-- Show for XML log -->
        <Rule kind="TestStep" sink="XMLLog" delete="false"/>
        <Rule kind="Checkpoint" sink="XMLLog" delete="false"/>
        <Rule kind="CheckSucceeded" sink="XMLLog" delete="false"/>
        <Rule kind="CheckFailed" sink="XMLLog" delete="false"/>
        <Rule kind="CheckInconclusive" sink="XMLLog" delete="false"/>
        <Rule kind="Comment" sink="XMLLog" delete="false"/>
        <Rule kind="Warning" sink="XMLLog" delete="false"/>
        <Rule kind="Debug" sink="XMLLog" delete="false"/>
        <Rule kind="TestFailed" sink="XMLLog" delete="false"/>
        <Rule kind="TestInconclusive" sink="XMLLog" delete="false"/>
        <Rule kind="TestPassed" sink="XMLLog" delete="false"/>

        <!-- Show for debugging -->
        <Rule kind="TestStep" sink="Debug" delete="false"/>
        <Rule kind="BeginGroup" sink ="Debug"/>
        <Rule kind="EndGroup" sink="Debug"/>
        <Rule kind="Checkpoint" sink="Debug" delete="false"/>
        <Rule kind="CheckSucceeded" sink="Debug" delete="false"/>
        <Rule kind="CheckFailed" sink="Debug" delete="false"/>
        <Rule kind="CheckInconclusive" sink="Debug" delete="false"/>
        <Rule kind="EnterMethod" sink="Debug"/>
        <Rule kind="ExitMethod" sink="Debug"/>
        <Rule kind="Comment" sink="Debug" delete="false"/>
        <Rule kind="Warning" sink="Debug" delete="false"/>
        <Rule kind="Debug" sink="Debug" delete="false"/>
        <Rule kind="TestFailed" sink="Debug" delete="false"/>
        <Rule kind="TestInconclusive" sink="Debug" delete="false"/>
        <Rule kind="TestPassed" sink="Debug" delete="false"/>

        <!--Shown for Protocol Test Manager-->
        <Rule kind="Checkpoint" sink="PipeSink" delete="false" />
        <Rule kind="CheckFailed" sink="PipeSink" delete="false" />
        <Rule kind="CheckSucceeded" sink="PipeSink" delete="false" />
        <Rule kind="CheckInconclusive" sink="PipeSink" delete="false"/>
        <Rule kind="TestInProgress" sink="PipeSink" delete="false" />
        <Rule kind="TestFailed" sink="PipeSink" delete="false" />
        <Rule kind="TestInconclusive" sink="PipeSink" delete="false" />
        <Rule kind="TestPassed" sink="PipeSink" delete="false" />
        <Rule kind="TestError" sink="PipeSink" delete="false" />
        <Rule kind="TestTimeout" sink="PipeSink" delete="false" />
        <Rule kind="TestAborted" sink="PipeSink" delete="false" />
        <Rule kind="Comment" sink="PipeSink" delete="false" />
      </Profile>
    </Profiles>
  </TestLog>
</TestSite>