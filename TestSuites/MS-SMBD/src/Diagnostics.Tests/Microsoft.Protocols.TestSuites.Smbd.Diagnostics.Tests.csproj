<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Microsoft.Protocols.TestSuites.Smbd.Diagnostics.Tests</RootNamespace>
    <AssemblyName>Microsoft.Protocols.TestSuites.Smbd.Diagnostics.Tests</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA2252</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Runner\ExecutableFixture\**\*.cs" />
    <ProjectReference Include="Runner\ExecutableFixture\Runner.TestSupport.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="..\..\..\..\AssemblyInfo\SharedAssemblyInfo.cs" Link="SharedAssemblyInfo.cs" />
  </ItemGroup>
  <Target Name="CopyRunnerExecutableFixture" AfterTargets="Build">
    <ItemGroup>
      <RunnerFixtureFiles Include="..\Diagnostics.Runner\bin\$(Configuration)\net8.0\**\*" />
      <RunnerHook Include="Runner\ExecutableFixture\bin\$(Configuration)\net8.0\Microsoft.Protocols.TestSuites.Smbd.Diagnostics.Runner.TestSupport.*" />
    </ItemGroup>
    <Copy SourceFiles="@(RunnerFixtureFiles)" DestinationFiles="@(RunnerFixtureFiles->'$(OutDir)runner-host\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(RunnerHook)" DestinationFolder="$(OutDir)runner-host" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Common\Diagnostics\Microsoft.Protocols.TestSuites.Diagnostics.csproj" />
    <ProjectReference Include="..\Diagnostics\Microsoft.Protocols.TestSuites.Smbd.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.9.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.9.1" />
  </ItemGroup>
</Project>
