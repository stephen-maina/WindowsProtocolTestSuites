<?xml version="1.0" encoding="utf-8" ?>
<TestSite xmlns="http://schemas.microsoft.com/windows/ProtocolsTest/2007/07/TestConfig"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Properties>
    <Group name="Common">
      <Property name="Diagnostics.Enabled" value="false" />
    </Group>
  </Properties>
  <Adapters>
    <Adapter xsi:type="managed" name="ILifecycleAdapter"
             adaptertype="Microsoft.Protocols.TestSuites.FileSharing.Diagnostics.Tests.LifecycleAdapter" />
  </Adapters>
</TestSite>
